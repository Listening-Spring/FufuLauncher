<UserControl
    x:Class="FufuLauncher.Views.Controls.CycleChallenge.AvatarBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:FufuLauncher.Views.Controls.CycleChallenge"
    HorizontalAlignment="Left"
    VerticalAlignment="Top">

    <Grid x:Name="AvatarRoot"
          Background="Transparent"
          Width="40"
          Height="40">
        <!-- 头像图片：由代码裁剪为圆形 -->
        <cc:RemoteImage x:Name="AvatarImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <!-- 无图占位：问号（本控件没有名字入参，用 ? 统一占位） -->
        <TextBlock x:Name="InitialText"
                   Text="?"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <!-- 稀有度描边：光晕层 + 主描边层 -->
        <Ellipse x:Name="RarityGlow"
                 StrokeThickness="5"
                 Opacity="0.28"
                 IsHitTestVisible="False" />
        <Ellipse x:Name="RarityRing"
                 StrokeThickness="2"
                 IsHitTestVisible="False" />

        <!-- 右下角等级角标 -->
        <Border x:Name="LevelBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,-2,-2"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="999"
                Padding="4,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="LevelText"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>